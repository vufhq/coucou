{
  "name": "coucou-orchestrator",
  "private": true,
  "type": "module",
  "workspaces": ["protocol", "server", "worker"],
  "scripts": {
    "start": "node --env-file-if-exists=.env server/src/main.ts",
    "worker": "node worker/src/main.ts",
    "worker-token": "node server/src/print-token.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
