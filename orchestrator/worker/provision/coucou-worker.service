[Unit]
Description=Coucou orchestrator worker
# /computer is the shared disk: never the VM's own folder by mistake.
Requires=coucou-computer.service
After=network-online.target coucou-computer.service
Wants=network-online.target coucou-runner.socket

[Service]
User=agent
Group=agent
WorkingDirectory=/opt/coucou-worker
# ORCH_AGENT_ID: which agent this VM is, written by setup.sh.
EnvironmentFile=/etc/coucou-worker/agent.env
Environment=ORCH_WORKSPACE=/workspace
# Task folders live on the computer's disk, shared with coucou-runner, which
# runs the agents' shell commands as another user.
Environment=ORCH_COMPUTER=/computer
Environment=HOME=/workspace/.coucou/home
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/coucou-worker/browsers
# The token file is root-only; systemd hands this service a private copy.
LoadCredential=worker-token:/etc/coucou-worker/worker-token
ExecStart=/usr/local/bin/node worker/src/main.ts
Restart=always
RestartSec=3

# The worker may write to /workspace (its own) and /computer, nowhere else.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/workspace /computer
# Files it creates on the computer stay writable by the runner (group computer).
UMask=0007
# Folders WSL shares between every distro on the PC: other agents, and the
# sockets of Podman, Docker or WSLg (whose user ids can equal ours). Never
# reachable from here.
InaccessiblePaths=-/mnt/wsl -/mnt/wslg -/tmp/.X11-unix
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
# The worker and its browser reach the internet and the backend on the PC,
# never the local network: a web page cannot use the browser to get at the
# router or another machine, whatever a name resolves to. 172.16.0.0/12 is
# where WSL puts the PC (the default gateway, where the backend listens);
# 10.255.255.254 is WSL's DNS tunnel. The runner's rule is stricter still
# (coucou-runner.service): it cannot reach the PC at all.
IPAddressDeny=10.0.0.0/8 192.168.0.0/16 169.254.0.0/16 100.64.0.0/10 fc00::/7 fe80::/10
IPAddressAllow=localhost 10.255.255.254

[Install]
WantedBy=multi-user.target
